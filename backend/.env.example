APP_NAME=PeoplePay360
ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=pp360
DB_PASSWORD=change_me
DB_NAME=peoplepay360

# Generate a real secret before deploying anywhere beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_to_a_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:5173

# Leave SMTP_HOST empty to run without email delivery. In that mode the API
# honestly reports EMAIL_NOT_CONFIGURED instead of pretending to send mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@peoplepay360.local
SMTP_USE_TLS=true
